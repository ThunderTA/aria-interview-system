MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=aria
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173

# Local LLM via Ollama — no API key needed. Install: brew install ollama
# Then: ollama serve && ollama pull qwen2.5:7b
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
LLM_TIMEOUT_SECONDS=120

# Speech-to-text via faster-whisper. Runs locally; the model downloads on
# first use. "base" is faster, "small" is more accurate — and since a
# mis-transcribed answer gets mis-scored, accuracy is worth the extra second.
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8

# Candidate identity verification (face embeddings, runs locally). The two
# small ONNX models (~39 MB) download to ~/.cache/aria/models on first start.
IDENTITY_VERIFICATION_ENABLED=true
# Fernet key for stored face embeddings. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave empty locally to derive one from JWT_SECRET.
FACE_EMBEDDING_KEY=
# Cosine similarity needed to count as the same person.
IDENTITY_RESUME_MATCH_THRESHOLD=0.363
IDENTITY_CAMERA_MATCH_THRESHOLD=0.42
IDENTITY_CHECK_INTERVAL_SECONDS=15
# Consecutive bad checks before an integrity event is recorded.
IDENTITY_MISMATCH_STREAK_TO_FLAG=3
IDENTITY_MULTI_FACE_STREAK_TO_FLAG=2
# Failed resume-photo matches before "continue without a match" is offered.
IDENTITY_START_MAX_ATTEMPTS=3
IDENTITY_ALLOW_CONTINUE_UNMATCHED=true

# Conversational interview. The interviewer's voice runs locally with Kokoro;
# its model files (~350 MB) download to ~/.cache/aria/models/kokoro on first start.
TTS_ENABLED=true
# Any Kokoro English voice, e.g. af_heart, af_bella, am_michael, bf_emma, bm_george.
TTS_VOICE=af_heart
TTS_SPEED=1.0
CONVERSATION_MAX_FOLLOW_UPS=2
CONVERSATION_MAX_CLARIFICATIONS=2
